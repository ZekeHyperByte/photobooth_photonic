# Supabase Database URL (use connection pooling URL from Supabase)
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# API key for booth sync + payment authentication (X-API-Key header)
API_KEY=your-secret-api-key

# Midtrans credentials (server-side only — never deployed to booths)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENVIRONMENT=sandbox  # 'sandbox' or 'production'

# Hosted photos (Phase 3). With a token, photos go to Vercel Blob.
# Without it (local dev), they're stored on local disk under .data/hosted.
BLOB_READ_WRITE_TOKEN=
